# ---------------------------------------------------------------
# PUBLIC values (VITE_ prefix). These are bundled into the website,
# so never put secrets here.
# ---------------------------------------------------------------
VITE_FIRM_NAME="Your Firm Name"
VITE_SITE_URL="https://www.your-firm-domain.com"
VITE_FIRM_EMAIL="contact@your-firm-domain.com"
VITE_FIRM_PHONE="+91 00000 00000"
VITE_FIRM_ADDRESS="Office address to be supplied by the firm"
VITE_FIRM_HOURS="Monday to Friday, 10:00 am to 6:00 pm"
# Paste a Google Maps "Embed a map" src URL ONLY once the office location is confirmed.
VITE_MAP_EMBED_URL=""
VITE_LINKEDIN_URL=""
VITE_FACEBOOK_URL=""
VITE_INSTAGRAM_URL=""
# Optional: only if the API lives on a different origin than the website.
VITE_ENQUIRY_ENDPOINT="/api/enquiry"

# ---------------------------------------------------------------
# PRIVATE values (server only, used by api/enquiry.js).
# Set these in your hosting dashboard (Vercel > Settings > Environment Variables)
# or in .env.local for `vercel dev`. Never prefix them with VITE_.
# ---------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Inbox that receives enquiries. Comma-separate for more than one.
ENQUIRY_TO_EMAIL="enquiries@your-firm-domain.com"
# Must belong to a domain verified in Resend.
ENQUIRY_FROM_EMAIL="website@your-firm-domain.com"
ENQUIRY_FROM_NAME="Your Firm Name Website"
# Comma-separated origins allowed to call the API (recommended in production).
ALLOWED_ORIGINS="https://www.your-firm-domain.com,https://your-firm-domain.com"
